              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextAreaEstoque">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="Estoque&#xa;&#xa;Esta &#xe1;rea permite visualizar os produtos cadastrados no supermercado.&#xa;&#xa;Informa&#xe7;&#xf5;es apresentadas:&#xa;&#xa;ID: c&#xf3;digo de identifica&#xe7;&#xe3;o do produto.&#xa;&#xa;Nome: nome do produto.&#xa;&#xa;Quantidade: quantidade dispon&#xed;vel no estoque.&#xa;&#xa;Medida: unidade utilizada para contabilizar o produto.&#xa;&#xa;Pre&#xe7;o de venda unit&#xe1;rio: valor cobrado por unidade do produto.&#xa;&#xa;Total em estoque: soma dos valores potenciais de venda de todos os produtos dispon&#xed;veis.&#xa;&#xa;A tabela &#xe9; apenas para consulta e n&#xe3;o permite editar diretamente os dados.&#xa;&#xa;As quantidades s&#xe3;o atualizadas conforme as opera&#xe7;&#xf5;es de compra e venda realizadas no sistema."/>
                    <Property name="wrapStyleWord" type="boolean" value="true"/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
          </SubComponents>
        </Container>
