                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="Fechar Dia&#xa;&#xa;O bot&#xe3;o Fechar Dia ser&#xe1; respons&#xe1;vel por avan&#xe7;ar a data do sistema em um dia.&#xa;&#xa;Funcionamento previsto:&#xa;&#xa;As compras e vendas realizadas permanecem registradas na data correspondente.&#xa;&#xa;A data atual avan&#xe7;a para o dia seguinte.&#xa;&#xa;As novas opera&#xe7;&#xf5;es passam a ser registradas na nova data.&#xa;&#xa;O saldo e as quantidades em estoque s&#xe3;o mantidos, considerando as opera&#xe7;&#xf5;es realizadas anteriormente.&#xa;&#xa;Aten&#xe7;&#xe3;o: antes de fechar o dia, confira se todas as opera&#xe7;&#xf5;es foram registradas corretamente.&#xa;&#xa;"/>
                    <Property name="wrapStyleWord" type="boolean" value="true"/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
          </SubComponents>
        </Container>
