                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="Comprar&#xa;&#xa;Esta &#xe1;rea ser&#xe1; utilizada para registrar a compra de mercadorias destinadas ao abastecimento do supermercado.&#xa;&#xa;Funcionamento previsto:&#xa;&#xa;Selecionar ou informar o produto que ser&#xe1; comprado.&#xa;&#xa;Informar a quantidade adquirida.&#xa;&#xa;Registrar os valores da compra.&#xa;&#xa;Confirmar a opera&#xe7;&#xe3;o para atualizar a quantidade dispon&#xed;vel no estoque.&#xa;&#xa;Descontar o valor gasto do saldo do supermercado.&#xa;&#xa;As compras tamb&#xe9;m ser&#xe3;o registradas na data em que forem realizadas, permitindo sua consulta nos relat&#xf3;rios."/>
                    <Property name="wrapStyleWord" type="boolean" value="true"/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
          </SubComponents>
        </Container>
