                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="Relat&#xf3;rio do Dia&#xa;&#xa;Esta &#xe1;rea permitir&#xe1; consultar os resultados das opera&#xe7;&#xf5;es registradas na data atual do sistema.&#xa;&#xa;Informa&#xe7;&#xf5;es previstas:&#xa;&#xa;Valor total das vendas realizadas no dia.&#xa;&#xa;Valor total gasto na compra de mercadorias.&#xa;&#xa;Quantidade de opera&#xe7;&#xf5;es de compra e venda.&#xa;&#xa;Resultado financeiro di&#xe1;rio, calculado pela diferen&#xe7;a entre os valores vendidos e os valores gastos.&#xa;&#xa;As movimenta&#xe7;&#xf5;es ficar&#xe3;o associadas &#xe0; data em que ocorreram, permitindo acompanhar os resultados de cada dia."/>
                    <Property name="wrapStyleWord" type="boolean" value="true"/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
