            <Container class="javax.swing.JScrollPane" name="jScrollPaneSair">
              <AuxValues>
                <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
              </AuxValues>

              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextAreaSair">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="SAIR E LOGIN&#xa;&#xa;O botão &quot;Sair&quot;, no menu lateral, encerra o programa.&#xa;&#xa;No menu superior &quot;Login&quot;, a opção &quot;Logar conta&quot; abre a janela de autenticação. A opção &quot;Sair do usuário&quot; encerra a sessão e retorna à tela inicial.&#xa;&#xa;É necessário estar autenticado para acessar as funções principais do supermercado.&#xa;&#xa;Importante: os dados são mantidos na memória da aplicação e podem ser perdidos ao encerrar o programa. Esta versão não salva automaticamente compras, vendas, estoque ou relatórios em um banco de dados."/>
                    <Property name="wrapStyleWord" type="boolean" value="true"/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
