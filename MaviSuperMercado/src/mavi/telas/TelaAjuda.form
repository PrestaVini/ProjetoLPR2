          <SubComponents>
            <Container class="javax.swing.JScrollPane" name="jScrollPaneRelatorio">
              <AuxValues>
                <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
              </AuxValues>

              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextAreaRelatorio">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="RELATÓRIO DO DIA&#xa;&#xa;Clique em &quot;Relatório do dia&quot; no menu lateral para visualizar um resumo financeiro do dia atual.&#xa;&#xa;O relatório mostra:&#xa;&#xa;• Vendas: soma dos valores das vendas finalizadas.&#xa;• Compras: soma dos valores gastos nas compras finalizadas.&#xa;• Saldo diário final: diferença entre vendas e compras.&#xa;&#xa;Esse resultado diário é diferente do saldo geral do supermercado, exibido no menu lateral.&#xa;&#xa;Os totais são mantidos em memória durante a execução. Ainda não existe um histórico consultável de dias anteriores nem uma listagem individual das operações."/>
                    <Property name="wrapStyleWord" type="boolean" value="true"/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
          </SubComponents>
        </Container>
        <Container class="javax.swing.JPanel" name="jPanelFecharDia">
          <Constraints>
            <Constraint layoutClass="org.netbeans.modules.form.compat2.layouts.support.JTabbedPaneSupportLayout" value="org.netbeans.modules.form.compat2.layouts.support.JTabbedPaneSupportLayout$JTabbedPaneConstraintsDescription">
